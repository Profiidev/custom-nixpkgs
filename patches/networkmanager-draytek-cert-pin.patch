 use openssl::ssl::{SslConnector, SslMethod, SslOptions, SslVerifyMode};
 use std::pin::Pin;
 use tokio::io::{AsyncReadExt, AsyncWriteExt};
@@ -19,7 +20,10 @@ pub async fn connect(
     username: &str,
